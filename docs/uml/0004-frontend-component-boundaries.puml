@startuml
skinparam componentStyle rectangle

package "Frontend application" {
  [Composition root] as Root
  [Operations panel shell] as Shell
  [Mission operations view] as Planning
  [Result validation view] as Validation
  [Heatmap operations view] as Analysis
  [Location search view] as Search
  [Navigation workflow] as Navigation
  [Mission workflow] as Mission
  [Heatmap workflow] as Heatmap
  [MapController] as MapCtl
  [HttpMissionApi] as MissionApi
  [HttpMissionResultApi] as ResultApi
  [HttpSignalQualityApi] as SqApi
  [SignalQualityRenderer] as Renderer
  [Local palette / ui.config] as Preferences
}

cloud "Backend /api" as Backend

Root --> Shell
Root --> Navigation
Root --> Mission
Root --> Heatmap
Root --> MapCtl
Shell --> Planning
Shell --> Validation
Shell --> Analysis
Navigation --> Search
Navigation --> MapCtl : own layers + controls
Mission --> MapCtl : own layers + interactions
Mission --> MissionApi
Mission --> ResultApi
Heatmap --> MapCtl : own tile layer + legend
Heatmap --> SqApi
Heatmap --> Renderer
Heatmap --> Preferences
Renderer --> SqApi : getTile

MissionApi --> Backend
ResultApi --> Backend
SqApi --> Backend

note right of MapCtl
  Thin shell: OL Map, basemap,
  shared view helpers only.
  Feature layers belong to workflows.
end note

note right of Renderer
  Canvas (default) or WebGL adapter.
  Numeric tiles + client palette.
end note

note bottom of Backend
  Browser consumes typed contracts.
  Never talks to a drone directly.
end note
@enduml
