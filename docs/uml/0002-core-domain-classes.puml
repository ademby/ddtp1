@startuml
hide methods
skinparam classAttributeIconSize 0

class Operator
class OperationalArea
class AdministrativeGeography
class Drone
class Mission {
  lifecycleState
  earliestStart
  dispatchDeadline
}
class RouteRevision
class MissionResult
class ResultRevision
class Measurement
class Projection
class DataTile

enum MissionState {
  DRAFT
  PLANNED
  DISPATCHED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum MeasurementDecision {
  ACCEPTED
  REJECTED
  UNREVIEWED
}

Operator "1" --> "0..*" Mission : plans
OperationalArea "1" o-- "0..*" Mission : scopes
OperationalArea "1" o-- "0..*" AdministrativeGeography : references
Mission "1" *-- "1..*" RouteRevision : contains
Mission "1" --> "1" Drone : assigned before dispatch
Mission "1" --> "0..1" MissionResult : produces (implicit execution)
MissionResult "1" *-- "1..*" Measurement : contains
MissionResult "1" *-- "1..*" ResultRevision : is reviewed through
ResultRevision "1" --> "0..*" Measurement : decides
Projection "1" --> "1" ResultRevision : derives from approved data
Projection "1" *-- "0..*" DataTile : materializes as
MissionState <-- Mission : uses
MeasurementDecision <-- ResultRevision : records

note right of Mission
  Execution is implicit; there is no
  first-class ExecutionAttempt entity.
  A failed mission can create a new
  derived mission; it is not retried
  in place.
end note

note right of Measurement
  Raw measurements are immutable.
  Derived KPI values are not part of
  the measurement. Rejected measurements
  remain auditable but are excluded from
  approved projections.
end note

note right of DataTile
  Numeric values only.
  Presentation colors stay client-side.
end note
@enduml
