@startuml
skinparam componentStyle rectangle

package "Map shell" {
  [MapController] as MapController
  [BasemapManager] as Basemap
}

package "NavigationWorkflow" {
  [Geography layers] as GeographyLayer
  [Select interaction] as SelectIx
}

package "MissionWorkflow" {
  [Mission route layer] as MissionLayer
  [Measurement vector layer] as MeasurementLayer
  [MissionEditor / MeasurementReview] as Editors
}

package "HeatmapWorkflow" {
  [SignalQualityRenderer] as Renderer
  [SignalQualityTileSource Canvas] as CanvasSrc
  [SignalQualityTileSource WebGL] as WebGlSrc
  [SignalQualityLegend] as Legend
  [Palette] as Palette
}

package "OpenLayers" {
  [TileLayer / WebGLTileLayer] as TileLayers
  [VectorLayer / VectorSource] as Vectors
  [Tile and browser cache] as Cache
}

MapController --> Basemap
Navigation --> MapController : addLayer / addInteraction
Mission --> MapController : addLayer / addInteraction
Heatmap --> MapController : addLayer / addControl

GeographyLayer --> Vectors
SelectIx --> GeographyLayer
MissionLayer --> Vectors
MeasurementLayer --> Vectors
Editors --> MissionLayer
Editors --> MeasurementLayer

Renderer --> CanvasSrc
Renderer --> WebGlSrc
Renderer --> TileLayers
CanvasSrc --> Cache
WebGlSrc --> Cache
Legend --> Palette
Renderer --> Palette : client-side only

note right of CanvasSrc
  Backend returns normalized numeric data.
  Projection version is part of the cache key.
  Palette changes do not refetch tiles.
  Selection: ui.config.kpiRenderer.
end note

note bottom of Renderer
  WebGL adapter retained (ADR-0006).
  Canvas path is the live default.
end note
@enduml
